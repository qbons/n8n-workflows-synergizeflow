    {
      "parameters": {
        "jsCode": "let cta = $input.first().json.cta;\nlet cta_count = 0;\nlet conversion = 0;\nlet chat = $input.first().json.chat;\nif(cta != 'none'){\n  cta = JSON.parse(cta);\n  cta_count = cta.length;\n}else{\n  cta = []\n}\nif(cta_count > 0){\n  conversion = cta_count / chat * 100;\n  conversion = Math.round(conversion * 100) / 100\n}\n\nreturn {\n  chat_count: chat,\n  cta_count: cta_count,\n  conversion: conversion+'%',\n  cta_data: cta\n}"
      },
