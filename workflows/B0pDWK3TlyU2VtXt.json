    {
      "parameters": {
        "jsCode": "let cta = $('Check Insert Data').first().json.cta;\nlet data = $('Chat Agent').first().json.data;\ndata.date = new Date().toISOString();\n\nif(cta != \"none\"){\n  cta = JSON.parse(cta);\n  cta.push(data);\n}else{\n  cta = [data];\n}\n\nreturn {\n  agent_id: $('Check Insert Data').first().json.agent_id,\n  chat: $('Check Insert Data').first().json.chat,\n  cta: cta,\n  id: $('Check Insert Data').first().json.id\n}"
