      ],
      "id": "b2bc3221-2906-4f65-a3da-7019c9c2d17d",
      "name": "Edit Fields7"
    },
    {
      "parameters": {
        "jsCode": "const orientation = $('Prepare Data').first().json.orientation;\nconst withSubtitle = $('Prepare Data').first().json.with_subtitle;\nconst audioPath = 'audio.mp3';\nconst subtitlePath = 'subtitle.ass';\nconst outputPath = 'output.mp4';\nconst workDir = 'video_build';\n\n// Resolution based on orientation\nconst width = orientation === 'horizontal' ? 1920 : 1080;\nconst height = orientation === 'horizontal' ? 1080 : 1920;\nconst fps = 60;\nconst motionScale = 4;\n\nfunction getMotionFilter(effect, totalFrames, w, h) {\n\n  const motionW = w * motionScale;\n  const motionH = h * motionScale;\n\n  const frames = Math.max(totalFrames - 1, 1);\n\n  // Normalized progress: 0 → 1\n  const p = `(on/${frames})`;\n\n  // Smoother cubic ease-in-out.\n  const ease =\n    `(${p}*${p}*(3-2*${p}))`;\n\n  // Slightly smoother image enlargement before motion.\n  const upscale =\n    `scale=${motionW}:${motionH}:flags=lanczos`;\n\n  // Final reduction.\n  const downscale =\n    `scale=${w}:${h}:flags=lanczos`;\n\n  const filters = {\n\n    // ─────────────────────────────────────────────\n    // ZOOM IN\n    // 1.00 → 1.30\n    // ─────────────────────────────────────────────\n    zoom_in:\n      `${upscale},` +\n      `zoompan=` +\n      `z='1+0.30*${ease}'` +\n      `:x='iw/2-iw/zoom/2'` +\n      `:y='ih/2-ih/zoom/2'` +\n      `:d=${totalFrames}` +\n      `:s=${motionW}x${motionH}` +\n      `:fps=${fps}` +\n      `,${downscale}`,\n\n    // ─────────────────────────────────────────────\n    // ZOOM OUT\n    // 1.30 → 1.00\n    // ─────────────────────────────────────────────\n    zoom_out:\n      `${upscale},` +\n      `zoompan=` +\n      `z='1.30-0.30*${ease}'` +\n      `:x='iw/2-iw/zoom/2'` +\n      `:y='ih/2-ih/zoom/2'` +\n      `:d=${totalFrames}` +\n      `:s=${motionW}x${motionH}` +\n      `:fps=${fps}` +\n      `,${downscale}`,\n\n    // ─────────────────────────────────────────────\n    // PAN LEFT\n    // Right → Left\n    // ─────────────────────────────────────────────\n    pan_left:\n      `${upscale},` +\n      `zoompan=` +\n      `z='1.30'` +\n      `:x='(iw-iw/zoom)*(1-${ease})'` +\n      `:y='ih/2-ih/zoom/2'` +\n      `:d=${totalFrames}` +\n      `:s=${motionW}x${motionH}` +\n      `:fps=${fps}` +\n      `,${downscale}`,\n\n    // ─────────────────────────────────────────────\n    // PAN RIGHT\n    // Left → Right\n    // ─────────────────────────────────────────────\n    pan_right:\n      `${upscale},` +\n      `zoompan=` +\n      `z='1.30'` +\n      `:x='(iw-iw/zoom)*${ease}'` +\n      `:y='ih/2-ih/zoom/2'` +\n      `:d=${totalFrames}` +\n      `:s=${motionW}x${motionH}` +\n      `:fps=${fps}` +\n      `,${downscale}`,\n\n    // ─────────────────────────────────────────────\n    // PAN UP\n    // Bottom → Top\n    // ─────────────────────────────────────────────\n    pan_up:\n      `${upscale},` +\n      `zoompan=` +\n      `z='1.30'` +\n      `:x='iw/2-iw/zoom/2'` +\n      `:y='(ih-ih/zoom)*(1-${ease})'` +\n      `:d=${totalFrames}` +\n      `:s=${motionW}x${motionH}` +\n      `:fps=${fps}` +\n      `,${downscale}`,\n\n    // ─────────────────────────────────────────────\n    // PAN DOWN\n    // Top → Bottom\n    // ─────────────────────────────────────────────\n    pan_down:\n      `${upscale},` +\n      `zoompan=` +\n      `z='1.30'` +\n      `:x='iw/2-iw/zoom/2'` +\n      `:y='(ih-ih/zoom)*${ease}'` +\n      `:d=${totalFrames}` +\n      `:s=${motionW}x${motionH}` +\n      `:fps=${fps}` +\n      `,${downscale}`,\n\n    // ─────────────────────────────────────────────\n    // KEN BURNS IN\n    //\n    // Zoom:\n    //   1.00 → 1.25\n    //\n    // Position:\n    //   top-left → bottom-right\n    // ─────────────────────────────────────────────\n    ken_burns_in:\n      `${upscale},` +\n      `zoompan=` +\n      `z='1+0.25*${ease}'` +\n      `:x='(iw-iw/zoom)*${ease}'` +\n      `:y='(ih-ih/zoom)*${ease}'` +\n      `:d=${totalFrames}` +\n      `:s=${motionW}x${motionH}` +\n      `:fps=${fps}` +\n      `,${downscale}`,\n\n    // ─────────────────────────────────────────────\n    // KEN BURNS OUT\n    //\n    // Zoom:\n    //   1.25 → 1.00\n    //\n    // Position:\n    //   bottom-right → top-left\n    // ─────────────────────────────────────────────\n    ken_burns_out:\n      `${upscale},` +\n      `zoompan=` +\n      `z='1.25-0.25*${ease}'` +\n      `:x='(iw-iw/zoom)*(1-${ease})'` +\n      `:y='(ih-ih/zoom)*(1-${ease})'` +\n      `:d=${totalFrames}` +\n      `:s=${motionW}x${motionH}` +\n      `:fps=${fps}` +\n      `,${downscale}`,\n  };\n\n  return filters[effect] || filters.zoom_in;\n}\n\n// ── Transition duration ────────────────────────────────────────\nconst transitionDuration = 0.8; // seconds\n// ── Build commands ─────────────────────────────────────────────\nconst commands = [];\nconst clipFiles = [];\n\n// Phase 1: Generate individual clips with Ken Burns effects\n// NOTE: Each clip (except the last) is extended by transitionDuration to\n// compensate for xfade overlap. Without this, each xfade transition \"eats\"\n// transitionDuration from total video length, making video shorter than audio.\nfor (let idx = 0; idx < items.length; idx++) {\n  const item = items[idx];\n  const step = item.json.step;\n  const duration = parseFloat(item.json.audio_duration);\n  const effect = item.json.motion_effect || 'zoom_in';\n  const imagePath = item.json.image_path || `${step}.png`;\n  const clipPath = `${workDir}/clip_${step}.mp4`;\n  // Extend clip duration to compensate for xfade overlap\n  // Last clip doesn't need extension (no transition after it)\n  const isLastClip = (idx === items.length - 1);\n  const extraDuration = (isLastClip || items.length === 1) ? 0 : transitionDuration;\n  const effectiveDuration = duration + extraDuration;\n  const totalFrames = Math.ceil(effectiveDuration * fps);\n  const motionFilter = getMotionFilter(effect, totalFrames, width, height);\n  // Generate clip: image + zoompan effect\n  const cmd = `ffmpeg -y -hide_banner -loglevel error -nostats -loop 1 -i \"${imagePath}\" -vf \"${motionFilter}\" -t ${effectiveDuration.toFixed(2)} -c:v libx264 -pix_fmt yuv420p -r ${fps} \"${clipPath}\"`;\n  \n  commands.push(cmd);\n  clipFiles.push({ step, clipPath, duration: effectiveDuration, transition: item.json.transition || 'none' });\n}\n\n// Phase 2: Concatenate clips with transitions\n// Build complex filtergraph for xfade transitions\nlet phase2Command = '';\nif (clipFiles.length === 1) {\n  // Single clip, no transitions needed\n  phase2Command = `ffmpeg -y -hide_banner -loglevel error -nostats -i \"${clipFiles[0].clipPath}\" -i \"${audioPath}\" -c:v libx264 -c:a aac \"${outputPath}\"`;\n} else {\n  // Build xfade filter chain\n  const inputFlags = clipFiles.map(c => `-i \"${c.clipPath}\"`).join(' ');\n  \n  let filterChain = '';\n  let currentLabel = '[0:v]';\n  let cumulativeOffset = 0;\n  \n  for (let i = 0; i < clipFiles.length - 1; i++) {\n    const clip = clipFiles[i];\n    const nextLabel = i === clipFiles.length - 2 ? '[vout]' : `[v${i}]`;\n    const transition = clip.transition;\n    \n    // Calculate offset: where the transition starts\n    // offset = cumulative duration of all previous clips minus transition overlaps\n    if (i === 0) {\n      cumulativeOffset = clip.duration - transitionDuration;\n    } else {\n      cumulativeOffset += clip.duration - transitionDuration;\n    }\n    \n    // Map transition type to ffmpeg xfade transition name\n    const xfadeMap = {\n      crossfade: 'fade',\n      fade_black: 'fadeblack',\n      wipe_left: 'wipeleft',\n      wipe_right: 'wiperight',\n      none: 'fade', // fallback to fade for \"none\" in middle (last step handled separately)\n    };\n    \n    const xfadeType = xfadeMap[transition] || 'fade';\n    \n    filterChain += `${currentLabel}[${i + 1}:v]xfade=transition=${xfadeType}:duration=${transitionDuration}:offset=${cumulativeOffset.toFixed(2)}${nextLabel};`;\n    \n    currentLabel = nextLabel;\n  }\n  \n  // Remove trailing semicolon\n  filterChain = filterChain.replace(/;$/, '');\n  \n  // Final command: clips + transitions + audio + subtitle\n  phase2Command = `ffmpeg -y -hide_banner -loglevel error -nostats ${inputFlags} -i \"${audioPath}\" -filter_complex \"${filterChain}\" -map \"[vout]\" -map \"${clipFiles.length}:a\" -c:v libx264 -pix_fmt yuv420p -c:a aac \"${outputPath}\"`;\n}\ncommands.push(phase2Command);\n// Phase 3: Add subtitles (burn in)\nconst finalOutput = outputPath.replace('.mp4', '_final.mp4');\n\nif (withSubtitle) {\n  commands.push(`ffmpeg -y -hide_banner -loglevel error -nostats -i \"${outputPath}\" -vf \"ass=${subtitlePath}\" -c:v libx264 -c:a copy \"${finalOutput}\"`);\n} else {\n  // Rename/copy output.mp4 → output_final.mp4 tanpa subtitle\n  commands.push(`ffmpeg -y -hide_banner -loglevel error -nostats -i \"${outputPath}\" -c copy \"${finalOutput}\"`);\n}\n\n// ── Return commands ────────────────────────────────────────────\nreturn [\n  {\n    json: {\n      orientation,\n      resolution: `${width}x${height}`,\n      total_steps: items.length,\n      total_commands: commands.length,\n      commands: commands,\n      commands_joined: commands.join(' && '),\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
