    {
      "parameters": {
        "jsCode": "const editFields = $('Edit Fields').first().json;\nconst qdrantResult = $input.first().json.result[0].payload.metadata;\n\n// Build the base HTML Body\nlet htmlBody = `<strong>Goal:</strong> ${qdrantResult.goal_prompt}<br>\\n`;\nhtmlBody += `<strong>Name:</strong> ${editFields.name}<br>\\n`;\nhtmlBody += `<strong>Contact:</strong> ${editFields.contact}<br>\\n`;\n\n// Dynamically add any additional fields if they exist\nif (editFields.additional_field) {\n    try {\n        // Parse the JSON string sent by the LLM\n        const extraFields = JSON.parse(editFields.additional_field);\n        \n        // Loop through the parsed object and append to the email body\n        for (const [key, value] of Object.entries(extraFields)) {\n            // Capitalize the first letter of the key for a cleaner look\n            const formattedKey = key.charAt(0).toUpperCase() + key.slice(1);\n            htmlBody += `<strong>${formattedKey}:</strong> ${value}<br>\\n`;\n        }\n    } catch (error) {\n        // Failsafe in case the LLM returned a malformed JSON string\n    }\n}\n\nhtmlBody += `<strong>Message:</strong> ${editFields.ctaQuery}<br>\\n`;\n\nreturn [{\n  key: $vars.STATIC_TOKEN,\n  senderName: \"SynergizeFlow\",\n  fromEmail: \"noreply@synergizeflow.com\",\n  replyTo: \"noreply@synergizeflow.com\",\n  toEmail: qdrantResult.destination,\n  subject: editFields.website + \" User Inquiry\",\n  htmlBody: htmlBody\n}];"
      },
