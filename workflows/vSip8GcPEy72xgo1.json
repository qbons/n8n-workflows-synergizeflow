    {
      "parameters": {
        "jsCode": "const step = $('Split Out').all().at($runIndex)?.json;\nconst response = $input.first().json;\n\nif (!step) {\n  return [{\n    json: {\n      step: null,\n      image: {\n        kie_ai_status: \"failed\",\n        kie_ai_error: `Step tidak ditemukan untuk runIndex ${$runIndex}`\n      }\n    }\n  }];\n}\n\nconst taskId = response?.data?.taskId;\nconst code = response?.code;\nconst msg = response?.msg || \"Unknown KieAI error\";\n\nif (code !== 200 || !taskId) {\n  return [{\n    json: {\n      ...step,\n      image: {\n        ...step.image,\n        kie_ai_status: \"failed\",\n        kie_ai_error: `KieAI createTask failed: ${msg}`,\n        kie_ai_response: response\n      }\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...step,\n    image: {\n      ...step.image,\n      kie_ai_task_id: taskId,\n      kie_ai_status: \"pending\"\n    }\n  }\n}];"
      },
