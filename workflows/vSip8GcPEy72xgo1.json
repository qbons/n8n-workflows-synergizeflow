        "jsonBody": "={\n   \"model\": \"qwen/text-to-image\",\n  \"callBackUrl\": \"{{ $vars.SAAS_API }}/api/explainer/kieai-callback?explainer_id={{ $('Weebhook').item.json.body.explainer_id }}&step={{ $runIndex+1 }}\",\n   \"input\": {\n      \"prompt\": {{ JSON.stringify($json.prompt) }},\n      \"image_size\": {{ JSON.stringify($json.image_size) }},\n      \"guidance_scale\": 10,\n      \"enable_safety_checker\": true,\n      \"output_format\": {{ JSON.stringify($json.output_format) }},\n      \"negative_prompt\": {{ JSON.stringify($json.negative_prompt) }},\n      \"seed\": {{ $json.seed }}\n   }\n}",
