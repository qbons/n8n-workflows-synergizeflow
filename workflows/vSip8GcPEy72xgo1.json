      "name": "Split Out"
    },
    {
      "parameters": {
        "jsCode": "const steps = $json.steps || [];\n\nconst failedSteps = steps\n  .filter(step => step.image?.kie_ai_status === \"failed\")\n  .map(step => ({\n    step: step.step,\n    error: step.image?.kie_ai_error || \"Unknown image generation error\"\n  }));\n\nif (failedSteps.length > 0) {\n  return [{\n    json: {\n      success: false,\n      stage: \"image_generation\",\n      error: \"One or more image tasks failed to start\",\n      failed_steps: failedSteps,\n      steps\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    success: true,\n    steps\n  }\n}];"
      },
