    {
      "parameters": {
        "jsCode": "let data = {\n  agent_id: $('Prepare Data').first().json.agent_id,\n  domain: $('Prepare Data').first().json.domain,\n  title: $('Prepare Data').first().json.title,\n  orientation: $('Prepare Data').first().json.orientation,\n  total_steps: $('Prepare Data').first().json.total_steps,\n  steps: []\n}\nfor (const item of $input.first().json.data) {\n  if(item.status == \"ok\"){\n      data.steps.push({\n        step: item.step,\n        tts: item.step_config.tts,\n        image: {\n          gdrive_id: item.image.gdrive_id,\n          file_name: item.image.file_name,\n          mime: item.image.mime\n        },\n        video: {\n          subtitle: item.step_config.subtitle,\n          transition: item.step_config.transition,\n          motion_effect: item.step_config.motion_effect\n        }\n      })\n  }\n}\nreturn {data:data}"
