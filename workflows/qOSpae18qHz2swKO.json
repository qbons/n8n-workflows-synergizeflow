    {
      "parameters": {
        "jsCode": "const step = $json;\nconst body = $('Webhook').first().json.body || {};\n\nconst allReferences = Array.isArray(body.reference_images)\n  ? body.reference_images\n  : [];\n\nconst selectedIds = Array.isArray(step.image?.reference_images)\n  ? step.image.reference_images\n  : [];\n\nconst maxReferencesPerScene = 4;\n\nconst selectedReferences = selectedIds\n  .map((id) => allReferences.find((ref) => String(ref.id) === String(id)))\n  .filter(Boolean)\n  .slice(0, maxReferencesPerScene);\n\nif (!selectedReferences.length) {\n  return [{\n    json: {\n      step_data: step,\n      reference_error: \"No matching reference image details found\"\n    }\n  }];\n}\n\nreturn selectedReferences.map((reference, index) => ({\n  json: {\n    step_data: step,\n    reference,\n    reference_index: index + 1,\n    total_references: selectedReferences.length,\n    reference_warning: selectedIds.length > maxReferencesPerScene\n      ? `Only first ${maxReferencesPerScene} reference images were used for this scene`\n      : \"\"\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        576,
        16
      ],
