    {
      "parameters": {
        "jsCode": "const references = $json.references || [];\nconst first = references[0];\nconst step = first?.step_data;\n\nif (!step) {\n  return [{\n    json: {\n      image: {\n        process_status: \"failed\",\n        process_error: \"Step data missing while preparing Gemini payload\"\n      }\n    }\n  }];\n}\n\nconst body = $('Webhook').first().json.body || {};\nconst orientation = body.orientation || \"horizontal\";\nconst visualStyle = body.visual_style || \"\";\nconst aspectRatio = orientation === \"vertical\" ? \"9:16\" : \"16:9\";\n\nconst referenceSummary = references.map((item, index) => {\n  const ref = item.reference || {};\n  return [\n    `Reference ${index + 1}:`,\n    `ID: ${ref.id}`,\n    `Type: ${ref.type || \"other\"}`,\n    `Label: ${ref.label || \"\"}`,\n    `Description: ${ref.description || \"\"}`,\n    `Usage note: ${ref.usage_note || \"\"}`,\n    `Sensitive note: ${ref.sensitive_note || \"\"}`\n  ].join(\"\\n\");\n}).join(\"\\n\\n\");\n\nconst prompt = [\n  \"Create one image for an animated explainer scene.\",\n  \"\",\n  `Visual style: ${visualStyle}`,\n  `Scene prompt: ${step.image.prompt}`,\n  `Reference usage instruction: ${step.image.reference_usage || \"\"}`,\n  `Reference strength: ${step.image.reference_strength || \"normal\"}`,\n  \"\",\n  \"Reference image metadata:\",\n  referenceSummary,\n  \"\",\n  \"Use all attached reference images as visual guidance.\",\n  \"Integrate only the elements requested in the reference usage instruction.\",\n  \"Do not create a collage unless explicitly requested.\",\n  \"Preserve important identity cues such as logo colors, mascot shape, face identity, product UI, and readable brand text as much as possible.\",\n  \"If references conflict, prioritize the scene prompt and reference_usage instruction.\",\n  \"Generate one clean final scene image only. No explanation.\"\n].join(\"\\n\");\n\nconst parts = [\n  { text: prompt },\n  ...references\n    .map((item) => item.part)\n    .filter(Boolean)\n];\n\nreturn [{\n  json: {\n    ...step,\n    gemini_payload: {\n      contents: [\n        { parts }\n      ],\n      generationConfig: {\n        responseModalities: [\"image\"],\n        imageConfig: {\n          aspectRatio\n        }\n      }\n    }\n  }\n}];"
      },
