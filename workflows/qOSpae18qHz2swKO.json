        "jsCode": "return {\n  agent_id: $('Prepare Data').first().json.agent_id,\n  step: $('If Has Reference').first().json.step,\n  status: \"ok\",\n  image: {\n    gdrive_id: $input.first().json.image_id,\n    file_name: $input.first().json.file_name,\n    mime: $input.first().json.mime,\n    config: {\n      prompt: $('Loop Over Items').first().json.image.prompt,\n      negative_prompt: $('Loop Over Items').first().json.image.negative_prompt,\n      reference_usage: $('Loop Over Items').first().json.image.reference_usage,\n      reference_images: $('Loop Over Items').first().json.image.reference_images,\n      image_size: $('Loop Over Items').first().json.image.image_size,\n      reference_strength: $('Loop Over Items').first().json.image.reference_strength\n    }\n  },\n  step_config: {\n    tts: $('Loop Over Items').first().json.tts,\n    transition: $('Loop Over Items').first().json.transition,\n    motion_effect: $('Loop Over Items').first().json.motion_effect,\n    scene_description: $('Loop Over Items').first().json.scene_description,\n    subtitle: $('Loop Over Items').first().json.subtitle\n  }\n}"
